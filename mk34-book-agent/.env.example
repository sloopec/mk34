# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# --- Vertex AI / Gemini (scaffold default) ---------------------------------
# Nicht gebraucht im mk34-Projektumfang: kein GCP-Projekt, Eval und Retrieval
# laufen lokal (siehe plan.md -> Entschieden E1/E2). Zeilen bleiben als
# Scaffold-Konvention stehen, aber leer/ungenutzt.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# --- mk34: Model-Router, Gemini-first (TASK-002, Entscheidung E6/E7) -------
# app/models/router.py -> model_for(role) liest ausschliesslich diese vier
# Tier-Variablen; kein Agent-Modul haelt einen eigenen Modell-String.
# Rollen-Mapping: orchestrator/continuity/research -> fast,
# plot/character/editor/style -> heavy, classifier -> lite, scene -> eigene
# Variable (einzige Rolle mit vorgesehenem lokalem LLM, siehe unten).
# Startwerte (verifiziert 2026-08-17, siehe ../.claude/plans/README.md ->
# Model-Routing-Matrix):
MK34_MODEL_HEAVY=gemini-3.1-pro-preview
MK34_MODEL_FAST=gemini-3.7-flash
MK34_MODEL_LITE=gemini-3.5-flash-lite
MK34_MODEL_SCENE=gemini-3.1-pro-preview
#
# Gemini laeuft ueber den AI-Studio-Pfad -- GEMINI_API_KEY ist erforderlich,
# der Router bricht mit einer klaren Fehlermeldung ab, falls er fehlt (kein
# stiller Fallback):
# GEMINI_API_KEY=your-api-key-here
#
# Spaeter (nicht in diesem Plan angebunden, nur als Router-Zielwerte
# vorgesehen -- Umschaltung ist eine .env-Zeile, keine Code-Aenderung):
#   MK34_MODEL_HEAVY=anthropic/claude-opus-5   (via LiteLlm, ANTHROPIC_API_KEY noetig)
#   MK34_MODEL_FAST=anthropic/claude-sonnet-5
#   MK34_MODEL_LITE=anthropic/claude-haiku-4-5
#   MK34_MODEL_SCENE=local                      (-> 03-szenen-und-lokales-llm/TASK-001)
ANTHROPIC_API_KEY=sk-ant-...

# --- mk34: lokales unzensiertes Modell (llama.cpp, TASK-002/018) -----------
MK34_LOCAL_MODEL=openai/supergemma4
MK34_LOCAL_API_BASE=http://localhost:8080/v1
MK34_LOCAL_API_KEY=not-needed
MK34_LOCAL_HEALTH_URL=http://localhost:8080/health
MK34_ALLOW_CLOUD_FALLBACK=false

# --- mk34: aktives Buchprojekt (TASK-003/004/005) ---------------------------
MK34_BOOK_SLUG=life_link
MK34_BOOK_ROOT=books/life_link

# --- mk34: Eval-Judges, zweistufig (Entscheidung E4, ab TASK-008) ----------
MK34_JUDGE_MODEL_FAST=claude-sonnet-5
MK34_JUDGE_MODEL_CRAFT=claude-opus-5

# --- mk34: lokaler Retrieval-Index (TASK-015) -------------------------------
MK34_INDEX_PATH=books/life_link/.index/manuscript.db

# --- mk34: persistente ADK-Sessions (Entscheidung E3, TASK-001) ------------
# DatabaseSessionService statt InMemorySessionService, ab dem ersten Setup.
# sqlite+aiosqlite:// statt sqlite:// -- ADK's DatabaseSessionService braucht
# einen async SQLAlchemy-Treiber (siehe app/app_utils/services.py).
MK34_SESSION_DB_URL=sqlite+aiosqlite:///./data/sessions.db
